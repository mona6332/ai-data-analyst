# LLM 설정 (openai | anthropic)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 분석 대상 DB (지금은 임시 SQLite. 회사 DW 연결 시 커넥터만 교체)
WAREHOUSE_CONNECTOR=sqlite
WAREHOUSE_DSN=data/warehouse.db
SERVICE_DB_PATH=data/service.db
ALLOWED_TABLE_PREFIXES=gold_,g1_,domain_
SQL_MAX_ROWS=500
MAX_AGENT_STEPS=12
